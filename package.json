{
  "name": "yasmin-booking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "prisma db seed",
    "test": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:db:prepare": "tsx tests/support/prepare-test-database.ts",
    "test:integration": "node --import tsx --import ./tests/support/integration-env.ts --test --test-concurrency=1 \"tests/integration/**/*.test.ts\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "packageManager": "pnpm@10.32.1"
}
