# Yasmin booking — environment reference. Placeholders only; never commit real values.
# Copy to .env (git-ignored) for local development.

# --- Database (existing) ---------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Integration tests only; the database name must contain "test" (see tests/README.md).
# TEST_DATABASE_URL="postgresql://USER@localhost:5432/yasmin_booking_test"

# --- Stripe Checkout (existing) ---------------------------------------------
# Test keys (sk_test_…) everywhere except the production deployment.
STRIPE_SECRET_KEY=""
# Signing secret for POST /api/stripe/webhook. This is distinct from the API
# key and is never exposed to browsers. Use a test-mode `whsec_…` locally.
STRIPE_WEBHOOK_SECRET=""

# --- Public booking API (YASMIN-1F.4) ---------------------------------------
# Off unless exactly "true". When off, /api/bookings* return 404.
PUBLIC_BOOKING_ENABLED="false"

# Authoritative application origin: Origin checks, Stripe return URLs.
# https in production; http is accepted only for localhost outside production.
APP_BASE_URL="https://localhost:3000"

# Extra exact origins accepted on mutations (comma-separated, https, no
# wildcards), e.g. a Vercel preview alias. Rejected on VERCEL_ENV=production.
# PUBLIC_BOOKING_ADDITIONAL_ORIGINS="https://yasmin-booking-git-feature-team.vercel.app"

# HMAC key for rate-limit counters (>= 32 characters), e.g. `openssl rand -base64 48`.
# Rotating it resets all counters.
RATE_LIMIT_SECRET=""

# Client-IP source for rate limiting:
#   vercel — trust only x-vercel-forwarded-for; requires VERCEL=1 (set by Vercel). Required in production.
#   none   — local only: no trusted IP, all requests share one IP bucket.
TRUSTED_CLIENT_IP_SOURCE="none"

# --- Hairstyle portfolio images (YASMIN-3B.2B) ------------------------------
# Server-only Vercel Blob read/write token. Never prefix with NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=""
# Exact public origin for this Blob store, for example:
# https://STORE_ID.public.blob.vercel-storage.com
BLOB_PUBLIC_BASE_URL=""

# --- Transactional confirmation email (YASMIN-1G) -------------------------
# Resend API key and a verified sender address. Delivery is attempted only
# from the durable confirmation outbox after verified payment fulfillment.
RESEND_API_KEY=""
BOOKING_FROM_EMAIL=""
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to
# GET /api/cron/confirmation-emails (vercel.json). Random, >= 32 characters.
CRON_SECRET=""

# Optional JSON overrides of the default limits (limits only; windows are fixed), e.g.
# PUBLIC_BOOKING_RATE_LIMITS='{"bookingIp10m":5,"bookingIpDay":20,"bookingEmailDay":3,"bookingPhoneDay":3,"checkoutCredential10m":10,"checkoutIp10m":30,"statusCredential1m":60,"statusIp1m":120}'
