generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MediaType {
  IMAGE
  VIDEO
}

/// Durable work for objects that must no longer be retained in Blob storage.
/// It deliberately stores a pathname, not a provider credential or upload token.
enum HairstyleMediaCleanupOperation {
  DELETE_BLOB
}

enum HairstyleMediaCleanupState {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AppointmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentProvider {
  STRIPE
}

enum PaymentPurpose {
  BOOKING_DEPOSIT
}

/// Net state of one payment attempt. PAID and REFUNDED both mean money was
/// received (paidAt is set); REFUNDED means the full amount was refunded.
enum PaymentStatus {
  PENDING
  PAID
  /// No money moved: Checkout could not be created, or an async payment failed.
  FAILED
  REFUNDED
  /// No money moved: the Checkout Session expired (or can no longer be paid).
  EXPIRED
}

enum ConfirmationEmailState {
  PENDING
  SENDING
  SENT
  FAILED
}

/// The independently retried transactional notification recipients for one
/// confirmed appointment. Neither kind is marketing communication.
enum ConfirmationEmailKind {
  CUSTOMER_CONFIRMATION
  OWNER_NEW_BOOKING
}

/// Why a received charge has not been allocated to its appointment.
enum PaymentReconciliationReason {
  /// Capacity full or booking policy closed when the place was re-checked.
  PLACE_UNAVAILABLE
  /// The appointment was cancelled or otherwise not payable when the charge arrived.
  APPOINTMENT_NOT_PAYABLE
  /// Stripe's amount/currency differs from the Payment record.
  AMOUNT_MISMATCH
  /// The charge was (partly) refunded before it could be allocated.
  REFUNDED_BEFORE_ALLOCATION
}

enum AppointmentEventType {
  CREATED
  PAYMENT_CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
  CUSTOMER_UPDATED
  NOTE_UPDATED
  HOLD_EXPIRY_CHANGED
  PAYMENT_RECEIVED_UNCONFIRMED
  PAYMENT_REFUND_UPDATED
  ACCESS_REVOKED
}

model SalonLocation {
  id                   String        @id @default(cuid())
  name                 String
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  postalCode           String?
  phone                String?
  /// IANA timezone identifier (e.g. "America/New_York"). Defines the
  /// location's local calendar "today" for booking policy.
  timeZone             String
  isActive             Boolean       @default(true)
  acceptsOnlineBooking Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  bookingSlots         BookingSlot[]
  appointments         Appointment[]

  @@index([isActive])
  @@index([acceptsOnlineBooking])
}

model BookingSlot {
  id             String        @id @default(cuid())
  locationId     String
  localStartTime DateTime      @db.Time(0)
  capacity       Int
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  location       SalonLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  appointments   Appointment[]

  @@unique([locationId, localStartTime])
  @@index([locationId, isActive])
}

model Customer {
  id                     String                  @id @default(cuid())
  name                   String
  email                  String
  phone                  String
  /// When the customer's CURRENT email-marketing consent was granted; null =
  /// not consented. Evidence for the grant (and every withdrawal) lives in
  /// MarketingConsentEvent; a timestamp without a matching GRANTED event
  /// predates evidence capture and its evidence is unknown.
  emailMarketingAt       DateTime?
  /// As emailMarketingAt, for SMS marketing.
  smsMarketingAt         DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  appointments           Appointment[]
  marketingConsentEvents MarketingConsentEvent[]

  @@index([email])
  @@index([phone])
}

model HairstyleCategory {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  hairstyles  Hairstyle[]

  @@index([isActive, sortOrder])
}

model Hairstyle {
  id                String                      @id @default(cuid())
  categoryId        String
  name              String
  slug              String                      @unique
  description       String?
  /// Null means a draft/unpriced simple style. Prices are integer USD cents.
  priceCents        Int?
  /// A variant-based style cannot be booked without an active variant.
  requiresVariant   Boolean                     @default(false)
  isActive          Boolean                     @default(true)
  sortOrder         Int                         @default(0)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  category          HairstyleCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  media             HairstyleMedia[]
  mediaCleanupTasks HairstyleMediaCleanupTask[]
  variants          HairstyleVariant[]
  appointments      Appointment[]

  @@index([categoryId, isActive, sortOrder])
}

model HairstyleVariant {
  id           String        @id @default(cuid())
  hairstyleId  String
  name         String
  description  String?
  /// Null means a draft variant, never bookable.
  priceCents   Int?
  isActive     Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  hairstyle    Hairstyle     @relation(fields: [hairstyleId], references: [id], onDelete: Restrict)
  media        HairstyleMedia[]
  appointments Appointment[]

  @@unique([hairstyleId, name])
  @@unique([id, hairstyleId])
  @@index([hairstyleId, isActive, sortOrder])
}

model HairstyleMedia {
  id                 String            @id @default(cuid())
  hairstyleId        String
  /// Null = service gallery; non-null = the selected variant's gallery.
  hairstyleVariantId String?
  type               MediaType
  storageKey         String            @unique
  deliveryUrl        String?
  altText            String?
  caption            String?
  sortOrder          Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  hairstyle          Hairstyle         @relation(fields: [hairstyleId], references: [id], onDelete: Restrict)
  hairstyleVariant   HairstyleVariant? @relation(fields: [hairstyleVariantId, hairstyleId], references: [id, hairstyleId], onDelete: Restrict)

  @@index([hairstyleId, type, sortOrder])
  @@index([hairstyleVariantId, type, sortOrder])
}

/// An outbox for physical Blob deletion. Removing media metadata and adding
/// this record happen in one PostgreSQL transaction, so a visible record is
/// never left pointing to an object that was deleted first.
model HairstyleMediaCleanupTask {
  id            String                         @id @default(cuid())
  hairstyleId   String
  /// The deleted metadata id when this task was created by admin removal.
  /// No foreign key: the HairstyleMedia row has intentionally been deleted.
  sourceMediaId String?                        @unique
  storageKey    String
  operation     HairstyleMediaCleanupOperation @default(DELETE_BLOB)
  state         HairstyleMediaCleanupState     @default(PENDING)
  attemptCount  Int                            @default(0)
  lastFailure   String?
  nextAttemptAt DateTime                       @default(now())
  leaseToken    String?
  leasedAt      DateTime?
  completedAt   DateTime?
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
  hairstyle     Hairstyle                      @relation(fields: [hairstyleId], references: [id], onDelete: Restrict)

  @@unique([storageKey, operation])
  @@index([state, nextAttemptAt])
  @@index([leasedAt])
  @@index([hairstyleId])
}

model Appointment {
  id                           String                    @id @default(cuid())
  customerId                   String
  locationId                   String
  bookingSlotId                String
  hairstyleId                  String?
  hairstyleVariantId           String?
  appointmentDate              DateTime                  @db.Date
  status                       AppointmentStatus         @default(PENDING_PAYMENT)
  preferredStylistName         String?
  customerNotes                String?
  holdExpiresAt                DateTime?
  locationNameSnapshot         String
  slotTimeSnapshot             String
  hairstyleNameSnapshot        String?
  hairstyleVariantNameSnapshot String?
  totalPriceCents              Int
  depositAmountCents           Int
  balanceDueCents              Int
  /// USD for appointments created after catalog pricing; null preserves the
  /// genuinely unknown currency of older records.
  currency                     String?
  /// SHA-256 (lowercase hex) of the customer's anonymous booking-access token.
  /// The token itself is never stored. Never selected into appointment views.
  /// Hash, issuedAt and expiresAt are all set or all null (CHECK constraint in
  /// migration 20261014120000_booking_access_foundation); null = no public access.
  accessTokenHash              String?                   @unique
  accessTokenIssuedAt          DateTime?
  accessTokenExpiresAt         DateTime?
  /// Set once by revocation; requires a token. Never cleared.
  accessTokenRevokedAt         DateTime?
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  customer                     Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  location                     SalonLocation             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  bookingSlot                  BookingSlot               @relation(fields: [bookingSlotId], references: [id], onDelete: Restrict)
  hairstyle                    Hairstyle?                @relation(fields: [hairstyleId], references: [id], onDelete: Restrict)
  hairstyleVariant             HairstyleVariant?         @relation(fields: [hairstyleVariantId], references: [id], onDelete: Restrict)
  payments                     Payment[]
  events                       AppointmentEvent[]
  confirmationEmails           BookingConfirmationEmail[]

  @@index([appointmentDate, status])
  @@index([locationId, appointmentDate, bookingSlotId])
  @@index([customerId])
  @@index([holdExpiresAt])
  @@index([hairstyleVariantId])
}

/// Durable post-commit transactional notification intent. A confirmed
/// appointment produces one independently retried row for each recipient;
/// provider work is never part of payment fulfillment's database transaction.
model BookingConfirmationEmail {
  id                String                 @id @default(cuid())
  appointmentId     String
  /// Customer rows persist their recipient snapshot. Owner rows resolve the
  /// server-only configured recipient at delivery time, so configuration is
  /// never copied into booking data or a client response.
  recipientEmail    String?
  kind              ConfirmationEmailKind  @default(CUSTOMER_CONFIRMATION)
  state             ConfirmationEmailState @default(PENDING)
  attemptCount      Int                    @default(0)
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  providerMessageId String?
  lastError         String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  appointment       Appointment            @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, kind])
  @@index([state, createdAt])
}

// Payment invariants are enforced by CHECK constraints added in migration
// 20261013120000_payment_reconciliation_foundation (Prisma cannot express
// them): a received charge (paidAt) has a PaymentIntent and is either
// allocated or carries a reconciliation reason; refunds stay within
// 0..amountCents; REFUNDED means fully refunded.
//
// A reconciliation case is OPEN while reconciliationReason is set,
// allocatedAt is null and status is not REFUNDED. It closes only on evidence
// (allocation or a verified full refund), never on reconciliationNote.
//
// Requirements for the services built on this (YASMIN-1E.2+):
// - Stripe idempotency keys are retained for a limited time: an uncertain
//   Checkout creation is replayed only until providerCheckoutExpiresAt, then
//   finalized; never replayed indefinitely.
// - Refund snapshot ordering must not rely solely on request-start
//   timestamps (refundsSyncedAt is a guard, not proof of recency).
// - Payment confirmation locks the appointment and its destination slot.
// - No payment confirmation may bypass the capacity policy.
// - A paid but unallocated charge must remain discoverable.
model Payment {
  id                         String                       @id @default(cuid())
  appointmentId              String
  provider                   PaymentProvider
  purpose                    PaymentPurpose
  status                     PaymentStatus                @default(PENDING)
  amountCents                Int
  currency                   String                       @default("usd")
  providerCheckoutSessionId  String?                      @unique
  providerPaymentIntentId    String?                      @unique
  /// The Checkout Session expiry fixed when this attempt was created.
  providerCheckoutExpiresAt  DateTime?
  /// Fences the one Stripe create/recovery caller allowed outside DB locks.
  checkoutRecoveryLeaseToken String?
  checkoutRecoveryLeasedAt   DateTime?
  paidAt                     DateTime?
  /// Set once, when this charge confirmed its appointment. Never cleared.
  allocatedAt                DateTime?
  /// Sum of SUCCEEDED Stripe refunds, from the latest verified snapshot.
  refundedAmountCents        Int                          @default(0)
  refundsSyncedAt            DateTime?
  reconciliationReason       PaymentReconciliationReason?
  /// Informational only. Never evidence of allocation or refund.
  reconciliationNote         String?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  appointment                Appointment                  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  /// One deposit attempt per appointment.
  @@unique([appointmentId, purpose])
  @@index([appointmentId])
  @@index([status])
  @@index([reconciliationReason])
  /// Created by migration 20261015000000_checkout_recovery_leases.
  @@index([checkoutRecoveryLeasedAt])
}

/// How a verified payment failed to apply locally (mirrors the fulfillment
/// service's problem categories).
enum PaymentExceptionCategory {
  IDENTITY_CONFLICT
  CORRUPT_LOCAL_STATE
  MISSING_ASSOCIATION
  UNUSABLE_EVIDENCE
}

/// The fulfillment service's persistent problem codes.
enum PaymentExceptionProblem {
  LOCAL_RECORD_INVALID
  ALLOCATED_BUT_APPOINTMENT_PENDING
  CHECKOUT_SESSION_MISMATCH
  PAYMENT_INTENT_MISMATCH
  PAID_AT_MISMATCH
  VERIFIED_AMOUNT_CHANGED
  LOCAL_PAID_BUT_PROVIDER_UNPAID
  NO_PAYMENT_REQUIRED
  PAYMENT_NOT_FOUND
  REFERENCE_MISMATCH
  PROVIDER_IDENTITY_IN_USE
  LOCATION_TIME_ZONE_INVALID
}

/// Durable delivery state for a signed Stripe Event. The Stripe Event id is
/// the idempotency key; no raw payload, signature, card, or customer data is
/// retained.
enum StripeWebhookEventState {
  PENDING
  PROCESSING
  PROCESSED
  RECONCILIATION_REQUIRED
}

model StripeWebhookEvent {
  /// Stripe Event id (evt_*), supplied only after signature verification.
  id                  String                  @id
  type                String
  checkoutSessionId   String?
  state               StripeWebhookEventState @default(PENDING)
  attemptCount        Int                     @default(1)
  /// Random fencing token for the current PROCESSING lease; never retained after completion.
  leaseToken          String?
  processingStartedAt DateTime
  processedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([state, processingStartedAt])
  @@index([checkoutSessionId])
}

// Verified Stripe evidence that could not be applied to a Payment because the
// association itself is missing, disputed or corrupt. Deliberately NOT linked
// to Payment/Appointment by foreign key: the expected ids are what the
// evidence or lookup claimed, kept for investigation, not trusted links.
//
// One row per (provider, Checkout Session, problem): repeated deliveries of
// the same problem update the last observation; the first is never changed.
// Nothing resolves a row automatically. Unresolved = resolvedAt IS NULL, or
// observed again after it was resolved (lastObservedAt > resolvedAt).
// No card data, customer details or raw Stripe payloads are stored.
model PaymentProcessingException {
  id                    String                   @id @default(cuid())
  provider              PaymentProvider
  checkoutSessionId     String
  /// The verified charge's PaymentIntent; first one observed is kept.
  paymentIntentId       String?
  /// Unverified claims (lookup / session metadata); no foreign key on purpose.
  expectedPaymentId     String?
  expectedAppointmentId String?
  category              PaymentExceptionCategory
  problem               PaymentExceptionProblem
  /// Stripe verified a successful charge in at least one observation.
  moneyReceived         Boolean
  verifiedAmountCents   Int?
  verifiedCurrency      String?
  firstStripeEventId    String?
  lastStripeEventId     String?
  firstObservedAt       DateTime
  lastObservedAt        DateTime
  occurrenceCount       Int                      @default(1)
  resolvedAt            DateTime?
  /// Informational only; written by a human when resolving.
  resolutionNote        String?

  @@unique([provider, checkoutSessionId, problem])
  @@index([resolvedAt, lastObservedAt])
  @@index([paymentIntentId])
  @@index([expectedPaymentId])
  @@index([expectedAppointmentId])
}

model AppointmentEvent {
  id               String               @id @default(cuid())
  appointmentId    String
  type             AppointmentEventType
  details          Json?
  createdAt        DateTime             @default(now())
  /// Administrator attribution (YASMIN-2B.1). Actor and operation are paired
  /// for an administrator action and both null for system/customer events
  /// (CHECK constraint in migration 20261018000000).
  /// The acting AdminUser, derived from the server-side session, never from client input.
  actorAdminUserId String?
  /// Client-generated UUID for the action attempt; unique, so a retried
  /// request can never apply the same action twice.
  operationId      String?              @unique
  /// The administrator's stated reason (1–500 characters). Required for
  /// cancellation/rescheduling; null is permitted for completion/no-show.
  reason           String?
  appointment      Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  actor            AdminUser?           @relation(fields: [actorAdminUserId], references: [id], onDelete: Restrict)

  @@index([appointmentId, createdAt])
  @@index([actorAdminUserId])
}

model AdminUser {
  id                String             @id @default(cuid())
  email             String             @unique
  /// scrypt hash "scrypt$N$r$p$salt$key" (base64url); never plaintext. Null
  /// = no password set, so the admin cannot sign in. Set only by the
  /// provisioning script (scripts/admin-provision.ts).
  passwordHash      String?
  passwordUpdatedAt DateTime?
  /// Set = the admin cannot sign in and all their sessions are invalid.
  disabledAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessions          AdminSession[]
  /// Appointment changes this administrator made (attribution; never deleted).
  appointmentEvents AppointmentEvent[]
}

/// Database-backed admin session (YASMIN-2A). The browser holds an opaque
/// token in the __Host-yasmin_admin cookie; only its SHA-256 is stored.
/// Rows are never deleted on logout: revokedAt records it (audit trail).
model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  /// SHA-256 (lowercase hex) of the session token.
  tokenHash   String    @unique
  createdAt   DateTime  @default(now())
  /// Fixed at sign-in (ADMIN_SESSION_TTL); never extended.
  expiresAt   DateTime
  revokedAt   DateTime?
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId])
  @@index([expiresAt])
}

enum MarketingChannel {
  EMAIL
  SMS
}

enum MarketingConsentAction {
  GRANTED
  WITHDRAWN
}

enum MarketingConsentSource {
  /// The customer ticked the channel's (unticked-by-default) box on the public booking form.
  PUBLIC_BOOKING_FORM
  /// A staff member recorded the customer's request (withdrawals only); actorId says who.
  INTERNAL_OPERATOR
}

// Append-only evidence of marketing consent, one row per grant or withdrawal
// per channel. A database trigger (migration
// 20261014140000_public_booking_api_foundation) rejects UPDATE and DELETE.
// No rows were backfilled: consent recorded before this table existed has
// unknown evidence and is never represented as proven.
model MarketingConsentEvent {
  id             String                 @id @default(cuid())
  customerId     String
  channel        MarketingChannel
  action         MarketingConsentAction
  occurredAt     DateTime
  /// Identifier of the exact consent wording shown (GRANTED only).
  wordingVersion String?
  source         MarketingConsentSource
  /// Who recorded it, for INTERNAL_OPERATOR rows. Not a foreign key: history outlives accounts.
  actorId        String?
  createdAt      DateTime               @default(now())
  customer       Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, channel, occurredAt])
}

// Shared fixed-window rate-limit counters for the public booking API.
// Ephemeral, not history: keyHash is an HMAC-SHA256 of the identity (IP,
// email, phone, credential) under RATE_LIMIT_SECRET, so no raw identifier is
// stored. Rows are deleted once expired.
model RateLimitCounter {
  scope       String
  keyHash     String
  windowStart DateTime
  count       Int
  expiresAt   DateTime

  @@id([scope, keyHash, windowStart])
  @@index([expiresAt])
}
